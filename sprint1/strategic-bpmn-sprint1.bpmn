        <bpmndi:BPMNLabel>
          <dc:Bounds x="1112" y="545" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1">
        <di:waypoint x="246" y="520" />
        <di:waypoint x="300" y="520" />
      </bpmndi:BPMNEdge>
