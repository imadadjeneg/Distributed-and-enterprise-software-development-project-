<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Strategic" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_Strategic">
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_Payment" name="Payment Service" />
    <bpmn:participant id="Participant_Platform" name="Marketplace Platform" processRef="Process_Platform" />
    <bpmn:participant id="Participant_Producer" name="Producer" />
    <bpmn:participant id="Participant_Verification" name="Certification Verification Service" />
    <bpmn:messageFlow id="MF_Browse" name="Browse" sourceRef="Participant_Customer" targetRef="SP_Browse" />
    <bpmn:messageFlow id="MF_PlaceOrder" name="Place order" sourceRef="Participant_Customer" targetRef="SP_Checkout" />
    <bpmn:messageFlow id="MF_PaymentRequest" name="Payment request" sourceRef="SP_Checkout" targetRef="Participant_Payment" />
    <bpmn:messageFlow id="MF_PaymentResult" name="Payment result" sourceRef="Participant_Payment" targetRef="SP_Checkout" />
    <bpmn:messageFlow id="MF_Registration" name="Registration details" sourceRef="Participant_Producer" targetRef="SP_Onboarding" />
    <bpmn:messageFlow id="MF_ProductInfo" name="Product info" sourceRef="Participant_Producer" targetRef="SP_Listing" />
    <bpmn:messageFlow id="MF_CheckCert" name="Check certificate" sourceRef="SP_Listing" targetRef="Participant_Verification" />
    <bpmn:messageFlow id="MF_CertResult" name="Verification result" sourceRef="Participant_Verification" targetRef="SP_Listing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Platform" isExecutable="false">
    <bpmn:startEvent id="Start_Producer" name="Producer wants to sell" />
    <bpmn:subProcess id="SP_Onboarding" name="Producer Registration and Onboarding" />
    <bpmn:subProcess id="SP_Listing" name="Product Listing and Inventory" />
    <bpmn:subProcess id="SP_Browse" name="Browse, Search and Basket" />
    <bpmn:subProcess id="SP_Checkout" name="Checkout, Order and Payment" />
    <bpmn:subProcess id="SP_Fulfilment" name="Order Fulfilment" />
    <bpmn:subProcess id="SP_Commission" name="Commission and Payouts" />
    <bpmn:endEvent id="End_Payouts" name="Payouts complete" />
    <bpmn:startEvent id="Start_Quality" name="Quality concern reported" />
    <bpmn:subProcess id="SP_Quality" name="Food Quality Incident and Traceability" />
    <bpmn:endEvent id="End_Quality" name="Incident closed" />
    <bpmn:sequenceFlow id="SF_1" sourceRef="Start_Producer" targetRef="SP_Onboarding" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="SP_Onboarding" targetRef="SP_Listing" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="SP_Listing" targetRef="SP_Browse" />
    <bpmn:sequenceFlow id="SF_4" sourceRef="SP_Browse" targetRef="SP_Checkout" />
    <bpmn:sequenceFlow id="SF_5" sourceRef="SP_Checkout" targetRef="SP_Fulfilment" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="SP_Fulfilment" targetRef="SP_Commission" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="SP_Commission" targetRef="End_Payouts" />
    <bpmn:sequenceFlow id="SF_8" sourceRef="Start_Quality" targetRef="SP_Quality" />
    <bpmn:sequenceFlow id="SF_9" sourceRef="SP_Quality" targetRef="End_Quality" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Strategic">
    <bpmndi:BPMNPlane id="BPMNPlane_Strategic" bpmnElement="Collaboration_Strategic">
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="440" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Payment_di" bpmnElement="Participant_Payment" isHorizontal="true">
