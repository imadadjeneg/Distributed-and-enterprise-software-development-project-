        <bpmndi:BPMNLabel>
          <dc:Bounds x="1122" y="425" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Quality_di" bpmnElement="Start_Quality">
        <dc:Bounds x="832" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="812" y="545" width="76" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Quality_di" bpmnElement="SP_Quality" isExpanded="false">
        <dc:Bounds x="920" y="480" width="160" height="80" />
