      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Checkout_di" bpmnElement="SP_Checkout" isExpanded="false">
        <dc:Bounds x="500" y="250" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Fulfilment_di" bpmnElement="SP_Fulfilment" isExpanded="false">
